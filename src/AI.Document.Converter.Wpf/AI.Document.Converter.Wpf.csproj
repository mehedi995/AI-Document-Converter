<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AI.Document.Converter.Application\AI.Document.Converter.Application.csproj" />
    <ProjectReference Include="..\AI.Document.Converter.Domain\AI.Document.Converter.Domain.csproj" />
    <ProjectReference Include="..\AI.Document.Converter.Infrastructure\AI.Document.Converter.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
  </ItemGroup>

  <!-- ADR-001: copy the bundled Python engine (a PyInstaller "onedir" build; see
       scripts/build-python-engine.ps1 for why not the single-file "onefile" mode)
       into this app's own output folder if it has been built. The Condition
       keeps a plain `dotnet build` working for someone who hasn't run
       PyInstaller yet. -->
  <ItemGroup Condition="Exists('..\AI.Document.Converter.Python\dist\AIDocumentConverter.PythonEngine\AIDocumentConverter.PythonEngine.exe')">
    <None Include="..\AI.Document.Converter.Python\dist\AIDocumentConverter.PythonEngine\**\*.*"
          Link="PythonEngine\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The MIT/BSD/Apache/MPL components bundled in this app require their
       attribution to travel WITH the distribution, so these two files must land
       in the output (and therefore in the publish folder the installer packages,
       see scripts/installer.iss). Shipping the binaries without them would leave
       the attribution obligation unmet. -->
  <ItemGroup>
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyTitle>AI Document Converter</AssemblyTitle>
    <Product>AI Document Converter</Product>
  </PropertyGroup>

  <!-- docs/19-DEPLOYMENT-PLAN.md Section 1: a self-contained publish needs no
       separate .NET runtime install on the target machine (NFR-010). Only
       meaningful for `dotnet publish`, not the everyday `dotnet build` a
       developer runs while working - RuntimeIdentifier alone doesn't force
       every build to produce a runtime-specific output. -->
  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

</Project>
