<Window x:Class="AI.Document.Converter.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AI.Document.Converter.Wpf"
        mc:Ignorable="d"
        Title="AI Document Converter" Height="600" Width="900">
    <!-- A plain TabControl is the simplest navigation that covers two screens
         (docs/11-CODING-STANDARDS.md: no unnecessary abstraction) - revisit only
         if a later phase needs richer navigation than this. -->
    <TabControl>
        <TabItem Header="Convert">
            <ContentControl x:Name="DashboardHost" />
        </TabItem>
        <TabItem Header="Settings">
            <ContentControl x:Name="SettingsHost" />
        </TabItem>
    </TabControl>
</Window>
