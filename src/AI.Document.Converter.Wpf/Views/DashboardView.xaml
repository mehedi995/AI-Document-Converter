<UserControl x:Class="AI.Document.Converter.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:AI.Document.Converter.Wpf.Behaviors"
             xmlns:converters="clr-namespace:AI.Document.Converter.Wpf.Converters"
             mc:Ignorable="d"
             d:DesignHeight="480" d:DesignWidth="720">
    <UserControl.Resources>
        <converters:FileSizeConverter x:Key="FileSizeConverter" />
    </UserControl.Resources>

    <Grid Margin="16" behaviors:DropFilesBehavior.DropCommand="{Binding DropFilesCommand}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Content="Import Files..." Padding="16,4" Command="{Binding ImportFilesCommand}" />
            <Button Content="Import Folder..." Padding="16,4" Margin="8,0,0,0"
                    Command="{Binding ImportFolderCommand}" />
            <Button Content="Convert All" Padding="16,4" Margin="24,0,0,0"
                    Command="{Binding ConvertAllCommand}" />
            <Button Content="Generate Chunks" Padding="16,4" Margin="8,0,0,0"
                    Command="{Binding GenerateChunksCommand}" />
            <TextBlock Text="or drag and drop files/folders below" VerticalAlignment="Center" Margin="16,0,0,0"
                       FontStyle="Italic" Foreground="Gray" />
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="1">
            <ListView ItemsSource="{Binding ImportedFiles}" BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="180" DisplayMemberBinding="{Binding FileName}" />
                        <GridViewColumn Header="Type" Width="60" DisplayMemberBinding="{Binding FileType}" />
                        <GridViewColumn Header="Size" Width="80"
                                        DisplayMemberBinding="{Binding FileSizeBytes, Converter={StaticResource FileSizeConverter}}" />
                        <GridViewColumn Header="Status" Width="90" DisplayMemberBinding="{Binding Status}" />
                        <GridViewColumn Header="Result" Width="300" DisplayMemberBinding="{Binding ResultSummary}" />
                    </GridView>
                </ListView.View>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="Red" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Border>

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="DarkOrange" />

        <!-- FR-017/AC-013: always visible whenever token counts might be shown,
             not conditional on a conversion having happened yet. -->
        <TextBlock Grid.Row="6" TextWrapping="Wrap" FontStyle="Italic" Foreground="Gray" FontSize="11"
                   Text="Token counts shown above are estimates and may vary from an AI provider's actual tokenizer." />
    </Grid>
</UserControl>
