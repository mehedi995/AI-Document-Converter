<Window x:Class="AI.Document.Converter.Wpf.Views.StartupErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Document Converter - Setup Required"
        Height="220" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="14" Text="{Binding Message}" />
        <Button Grid.Row="1" Content="Close" HorizontalAlignment="Right" Padding="24,4"
                IsCancel="True" Click="OnCloseClicked" />
    </Grid>
</Window>
