@model AI.Document.Converter.Web.Controllers.UploadPageModel
@{ ViewData["Title"] = "New conversion"; }
<h1>New conversion</h1>
<div asp-validation-summary="All"></div>
<form method="post" enctype="multipart/form-data">
    <p><input type="file" name="files" multiple
              accept=".pdf,.docx,.xlsx,.pptx,.txt" /></p>
    <p>
        <label for="preset">Preset</label>
        @* SaaS section 10: a small number of understandable presets. Chunk
           sizes stay server-side behind the name. *@
        <select id="preset" name="preset">
            @foreach (var option in Model.Presets)
            {
                <option value="@option.Name">@option.DisplayName — @option.Description</option>
            }
        </select>
    </p>
    <p>Up to @Model.MaxFiles files, @Model.MaxFileSizeMb MB each. PDF, DOCX, XLSX, PPTX, TXT.</p>
    @* The balance and the rule, before the upload rather than after it. The
       exact cost of a document is not knowable until its bytes arrive, so this
       page states how conversions are counted instead of quoting a figure it
       would have to guess at. *@
    <p>
        <strong>Credits:</strong>
        @if (Model.AvailableCredits is { } available)
        {
            <text>@available.ToString("N0") of @Model.IncludedCredits!.Value.ToString("N0") remaining
            this period.</text>
        }
        else
        {
            <text>Nothing has been converted yet this period.</text>
        }
        <br />
        <span>@Model.CreditRule</span>
        <br />
        <span>Credits are a measure of processing, not of AI tokens. A conversion that cannot
              be covered is refused rather than charged as an overage.</span>
    </p>
    @* Rendered from the same RetentionPolicy the worker's sweep enforces, so
       this sentence cannot drift away from what actually happens. *@
    <p><strong>Retention:</strong> @Model.RetentionNotice
       Files are processed on our servers; nothing is sent to a third-party AI service.</p>
    <button type="submit">Upload and convert</button>
</form>
<p><a asp-controller="Dashboard" asp-action="Index">Back to dashboard</a></p>
