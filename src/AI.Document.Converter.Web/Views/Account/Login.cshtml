@model AI.Document.Converter.Web.Models.LoginViewModel
@{ ViewData["Title"] = "Sign in"; }
<h1>Sign in</h1>
<form method="post">
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
    <div asp-validation-summary="All"></div>
    <p><label asp-for="Email"></label><input asp-for="Email" type="email" autocomplete="email" /></p>
    <p><label asp-for="Password"></label><input asp-for="Password" autocomplete="current-password" /></p>
    <p><label asp-for="RememberMe"></label><input asp-for="RememberMe" /></p>
    <button type="submit">Sign in</button>
</form>
<p><a asp-action="Register">Create an account</a></p>
