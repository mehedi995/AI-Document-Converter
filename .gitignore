# .NET build output
bin/
obj/
*.user
.vs/

# Python build artifacts (rebuilt via scripts/build-python-engine.ps1, not committed)
src/AI.Document.Converter.Python/build/
src/AI.Document.Converter.Python/dist/
__pycache__/
*.pyc

# Release publish output (rebuilt via `dotnet publish`, docs/19-DEPLOYMENT-PLAN.md - not committed)
publish/

# Local Claude Code session/tooling state, not project source
.claude/

# Editor/tool-generated file unrelated to this project (Azure/Copilot MCP
# boilerplate, not authored as part of this codebase)
.github/copilot-instructions.md

# OS/editor noise
.DS_Store
Thumbs.db

# EF Core design-time artifacts and local tool state
*.received.*

# Local user secrets are stored outside the repo by dotnet user-secrets, but
# guard against anyone hand-creating one here (SEC-003).
secrets.json
appsettings.Local.json

# Cost-benchmark corpus and raw timings (scripts/generate-cost-corpus.py,
# scripts/measure-conversion-cost.py). Regenerable, several MB, and the
# timings are machine-specific - the conclusions live in
# docs/saas/05-CREDIT-COST-BENCHMARK.md instead.
artifacts/cost-corpus/
artifacts/cost-measurements*.json
